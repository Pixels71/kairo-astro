---
import Button from '@/components/shared/ui/button.astro';
import Layout from '@/layouts/layout.astro';
import { pageTitle } from '@/utils/generate-meta-data';
---

<Layout title={pageTitle('Page not found')} description="This page slipped past us.">
  <section class="relative isolate min-h-[100dvh] overflow-hidden" data-hero aria-labelledby="missing-title">
    <canvas class="absolute inset-0 -z-10 size-full" data-signal-field aria-hidden="true"></canvas>
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_50%_50%,transparent_10%,var(--color-ink)_80%)]"
      aria-hidden="true">
    </div>
    <div class="shell flex min-h-[100dvh] flex-col items-start justify-end gap-10 pt-28 pb-14">
      <p class="font-mono text-label text-mute uppercase" data-intro>Error 404</p>
      <h1 id="missing-title" class="font-display text-hero font-extrabold text-bone">
        <span class="block overflow-hidden pb-[0.04em]" data-hero-line><span class="block">This page</span></span>
        <span class="block overflow-hidden pb-[0.06em]" data-hero-line>
          <span class="block">slipped <span class="text-signal">past us.</span></span>
        </span>
      </h1>
      <div class="flex flex-wrap items-center gap-6" data-intro>
        <Button label="Back to home" href="/" icon="arrow-left" />
        <p class="max-w-[36ch] text-mute">Click anywhere in the field to send a pulse while you are here.</p>
      </div>
    </div>
  </section>
</Layout>
