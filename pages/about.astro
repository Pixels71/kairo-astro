---
import AboutHero from '@/components/about/about-hero.astro';
import Roles from '@/components/about/roles.astro';
import Team from '@/components/about/team.astro';
import Timeline from '@/components/about/timeline.astro';
import Values from '@/components/about/values.astro';
import Layout from '@/layouts/layout.astro';
import { pageTitle } from '@/utils/generate-meta-data';
---

<Layout
  title={pageTitle('About')}
  image="/images/og/about.jpg"
  description="Kairo is built by a remote-first team in Berlin and London who think the warning should arrive before the damage.">
  <AboutHero />
  <Timeline />
  <Values />
  <Team />
  <Roles />
</Layout>
