---
import Odometer from '@/components/shared/ui/odometer.astro';
import type { Story } from '@/utils/collections';

interface Props {
  story: Story;
}

const { story } = Astro.props;
---

<section class="shell py-20 md:py-28" aria-label="Results">
  <dl class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-6">
    {story.data.results.map((result) => (
      <div class="border-t border-line pt-6" data-reveal>
        <dt class="sr-only">{result.label}</dt>
        <dd class="font-display text-display font-extrabold text-bone">
          <Odometer value={result.value} />
        </dd>
        <dd class="mt-3 max-w-[24ch] text-mute">{result.label}</dd>
      </div>
    ))}
  </dl>
</section>
