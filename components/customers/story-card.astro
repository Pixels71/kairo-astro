---
import Media from '@/components/shared/ui/media.astro';
import type { Story } from '@/utils/collections';
import { cn } from '@/utils/cn';

interface Props {
  story: Story;
  tall?: boolean;
  class?: string;
}

const { story, tall = false, class: className } = Astro.props;
---

<a
  href={`/customers/${story.id}`}
  class={cn('group flex flex-col gap-5', className)}
  data-chip="View story"
  data-label={story.data.client}
  data-filter-item
  data-category={story.data.industry}>
  <Media
    src={story.data.cover}
    alt={story.data.summary}
    class={cn('media-zoom w-full', tall ? 'aspect-[4/5]' : 'aspect-[4/3]')}
    sizes="(min-width: 768px) 45vw, 100vw"
  />
  <div class="flex items-start justify-between gap-6">
    <h2 class="max-w-[26ch] font-display text-[1.375rem] leading-[1.15] font-bold tracking-[-0.02em] text-bone md:text-[1.625rem]">
      {story.data.title}
    </h2>
    <span class="shrink-0 pt-1.5 font-mono text-label text-mute uppercase">{story.data.industry}</span>
  </div>
  <p class="font-mono text-label text-dim uppercase transition-colors duration-300 group-hover:text-signal">
    {story.data.client}
  </p>
</a>
