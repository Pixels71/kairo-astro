---
import { customersPage } from '@/data/pages';
import StoryCard from '@/components/customers/story-card.astro';
import FilterBar from '@/components/shared/ui/filter-bar.astro';
import { getStories } from '@/utils/collections';

const stories = await getStories();
const industries = [...new Set(stories.map((story) => story.data.industry))];
---

<section class="shell pb-28 md:pb-40" data-filter aria-label="Customer stories">
  <div class="flex flex-col gap-6 border-t border-line pt-8 md:flex-row md:items-center md:justify-between" data-reveal>
    <FilterBar options={industries} label={customersPage.grid.filterLabel} />
    <p
      class="text-sm text-mute"
      aria-live="polite"
      data-filter-count
      data-one={customersPage.grid.one}
      data-many={customersPage.grid.many}>
      {stories.length} {stories.length === 1 ? customersPage.grid.one : customersPage.grid.many}
    </p>
  </div>
  <div class="mt-12 grid grid-cols-1 gap-x-6 gap-y-16 md:mt-16 md:grid-cols-2 md:gap-y-24" data-filter-grid>
    {stories.map((story, i) => (
      <StoryCard story={story} tall={i % 4 === 0 || i % 4 === 3} />
    ))}
  </div>
  <p class="mt-16 hidden text-mute" data-filter-empty>
    {customersPage.grid.empty}
  </p>
</section>
