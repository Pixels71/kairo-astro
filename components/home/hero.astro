---
import { Image } from 'astro:assets';
import Button from '@/components/shared/ui/button.astro';
import NumberFlow from '@/components/shared/ui/number-flow.astro';
import { briefPortrait, moments } from '@/data/hero';
import { resolveImage } from '@/utils/image';

const [first] = moments;
---

<section class="relative isolate min-h-[100dvh] overflow-hidden" data-hero aria-labelledby="hero-title">
  <canvas class="absolute inset-0 -z-10 size-full" data-signal-field aria-hidden="true"></canvas>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-2/5 bg-gradient-to-t from-ink via-ink/70 to-transparent"
    aria-hidden="true"></div>

  <div
    class="shell grid min-h-[100dvh] grid-cols-1 content-end gap-y-7 pt-22 pb-10 md:pb-12 lg:grid-cols-12 lg:grid-rows-[1fr_auto] lg:content-stretch lg:gap-x-6 lg:gap-y-0 lg:pt-28"
    data-hero-sink>
    <div
      class="relative order-1 w-[56%] justify-self-end sm:w-[42%] lg:order-none lg:col-span-3 lg:col-start-10 lg:row-span-2 lg:row-start-1 lg:w-full lg:self-start"
      data-moments
      role="group"
      aria-roledescription="slideshow"
      aria-label="Customer results">
      <div class="mb-4 flex items-end justify-between gap-4 border-b border-line pb-3" data-intro>
        <div class="min-w-0 overflow-hidden">
          <p class="truncate font-mono text-label text-bone uppercase" data-moment-text="client">
            {first.client}
          </p>
          <p class="mt-1 truncate text-sm text-mute" data-moment-text="label">
            {first.label}
          </p>
        </div>
        <NumberFlow
          value={first.value}
          prefix={first.prefix}
          suffix={first.suffix}
          trigger="load"
          delay={0.5}
          duration={1.6}
          class="shrink-0 font-display text-[clamp(1.75rem,2.6vw,2.75rem)] leading-none font-bold tracking-[-0.03em] text-signal"
        />
      </div>

      <div class="relative" data-depth="0.6">
        <div class="relative aspect-[3/4] overflow-hidden bg-ink-3" data-moments-frame data-reveal-media>
          {moments.map((moment, i) => (
            <div
              class="absolute inset-0 overflow-hidden"
              style={i === 0 ? 'z-index:2' : 'clip-path: inset(100% 0% 0% 0%)'}
              data-moment
              data-client={moment.client}
              data-label={moment.label}
              data-value={moment.value}
              data-prefix={moment.prefix ?? ''}
              data-suffix={moment.suffix ?? ''}
              aria-hidden={i === 0 ? undefined : 'true'}>
              <Image
                src={resolveImage(moment.image)}
                alt={moment.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 32vw, (min-width: 640px) 46vw, 66vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="absolute inset-0 size-full object-cover"
                data-moment-image
              />
            </div>
          ))}
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-1/2 bg-gradient-to-t from-ink/80 to-transparent"></div>
        </div>
        <div class="mt-3 flex gap-1.5" aria-hidden="true">
          {moments.map(() => (
            <span class="relative h-px flex-1 overflow-hidden bg-bone/15">
              <span class="absolute inset-0 origin-left bg-bone" style="transform: scaleX(0)" data-moment-tick />
            </span>
          ))}
        </div>
      </div>

      <div
        class="absolute bottom-[14%] -left-[30%] z-20 w-[44%] sm:-left-[24%] lg:bottom-[40%] lg:-left-[30%] lg:w-[38%]"
        data-depth="1.4">
        <div class="aspect-[3/4] overflow-hidden bg-ink-3 shadow-[0_30px_80px_-20px_rgb(0_0_0/0.8)]" data-reveal-media>
          <Image
            src={resolveImage(briefPortrait.image)}
            alt={briefPortrait.alt}
            widths={[320, 640]}
            sizes="(min-width: 1024px) 14vw, 30vw"
            class="size-full object-cover"
          />
        </div>
      </div>
    </div>

    <div class="order-3 flex flex-col gap-8 lg:order-none lg:col-span-5 lg:col-start-1 lg:row-start-1 lg:self-end lg:pb-10">
      <p class="max-w-[36ch] text-lead text-mute" data-intro>
        Kairo reads your metrics, tickets and calls, then tells the right person what changed and why.
      </p>
      <div class="flex flex-wrap items-center gap-3" data-intro>
        <Button label="Start free" href="/pricing#sales" class="h-13 px-7" />
        <Button
          label="Book a demo"
          href="/pricing?intent=demo#sales"
          variant="outline"
          icon={false}
          class="h-13 px-7"
        />
      </div>
    </div>

    <h1
      id="hero-title"
      class="pointer-events-none relative z-30 order-2 font-display text-hero font-extrabold text-bone lg:order-none lg:col-span-12 lg:col-start-1 lg:row-start-2">
      <span class="block overflow-hidden pb-[0.04em]" data-hero-line>
        <span class="block">Know the moment</span>
      </span>
      <span class="block overflow-hidden pb-[0.06em]" data-hero-line>
        <span class="block">
          before it <span class="text-signal">passes.</span>
        </span>
      </span>
    </h1>
  </div>
</section>
