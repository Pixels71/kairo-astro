---
import { Image } from 'astro:assets';
import NumberFlow from '@/components/shared/ui/number-flow.astro';
import { cn } from '@/utils/cn';
import { resolveImage } from '@/utils/image';
import { productStory } from '@/data/home';

const slots = [
  { left: 6, top: 14, w: 11 },
  { left: 20, top: 6, w: 9 },
  { left: 31, top: 17, w: 12 },
  { left: 61, top: 7, w: 10 },
  { left: 74, top: 15, w: 12 },
  { left: 88, top: 8, w: 9 },
  { left: 3, top: 52, w: 10 },
  { left: 16, top: 60, w: 12 },
  { left: 30, top: 66, w: 9 },
  { left: 62, top: 64, w: 11 },
  { left: 75, top: 56, w: 9 },
  { left: 87, top: 58, w: 11 },
  { left: 47, top: 4, w: 8 },
  { left: 48, top: 78, w: 8 },
];

const { acts, title } = productStory;
const tiles = productStory.tiles.map((src, i) => ({ src, ...slots[i % slots.length], mobile: i % 2 === 0 }));
---

<section
  id="product"
  class="relative h-[100dvh] overflow-hidden bg-ink"
  data-product
  data-acts={JSON.stringify(acts.map(({ count, unit }) => ({ count, unit })))}
  aria-labelledby="product-title">
  <h2
    id="product-title"
    class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center font-display text-[clamp(3.5rem,13vw,15rem)] leading-[0.86] font-extrabold tracking-[-0.055em] text-bone/[0.07]"
    data-product-words>
    {title.map((line) => (
      <span>{line}</span>
    ))}
  </h2>

  <div class="absolute inset-0" data-product-stage aria-hidden="true">
    {tiles.map((tile) => (
      <div
        class={cn('absolute aspect-[4/5] min-w-[5.5rem] overflow-hidden bg-ink-3', !tile.mobile && 'hidden md:block')}
        style={`left:${tile.left}%; top:${tile.top}%; width:${tile.w}vw`}
        data-product-tile>
        <Image
          src={resolveImage(tile.src)}
          alt=""
          widths={[240, 400]}
          sizes="14vw"
          class="absolute inset-0 size-full object-cover"
        />
      </div>
    ))}
    <div
      class="absolute top-1/2 left-1/2 aspect-[4/5] w-[max(15vw,9rem)] -translate-x-1/2 -translate-y-1/2"
      data-product-anchor></div>
    <div class="absolute inset-0" data-product-hero>
      <Image
        src={resolveImage(productStory.heroImage)}
        alt=""
        widths={[800, 1200, 1400]}
        sizes="100vw"
        class="absolute inset-0 size-full object-cover"
        data-product-hero-image
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-ink/50 opacity-0" data-product-shade></div>
      <div class="absolute top-[42%] left-[56%] size-0 opacity-0" data-product-ping>
        <span class="absolute -inset-10 rounded-full border border-signal chart-ping"></span>
        <span class="absolute -inset-2 rounded-full bg-signal"></span>
      </div>
    </div>
    <div class="pointer-events-none absolute border-2 border-signal opacity-0" data-product-frame></div>
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-t from-ink via-ink/85 to-transparent"
    aria-hidden="true"></div>

  <div class="shell pointer-events-none absolute inset-x-0 bottom-0 grid grid-cols-1 gap-8 pb-8 md:grid-cols-12 md:items-end md:pb-12">
    <div class="md:col-span-7 lg:col-span-6">
      <p class="flex items-baseline gap-3">
        <NumberFlow
          value={acts[0].count}
          trigger="manual"
          duration={0.8}
          class="font-display text-[clamp(3rem,6vw,6rem)] leading-none font-extrabold tracking-[-0.045em] text-signal"
        />
        <span class="font-mono text-label text-bone uppercase" data-product-unit>
          {acts[0].unit}
        </span>
      </p>
      <div class="relative mt-5 grid">
        <span
          class="pointer-events-none absolute top-0 left-0 z-10 origin-left bg-signal"
          style="transform: scaleX(0)"
          aria-hidden="true"
          data-product-wipe></span>
        {acts.map((act, i) => (
          <div class="[grid-area:1/1]" data-product-caption style={i === 0 ? undefined : 'opacity:0'}>
            <h3
              class="inline-block font-display text-[clamp(1.75rem,3vw,3rem)] leading-[1.05] font-bold tracking-[-0.03em] text-bone"
              data-product-title>
              {act.title}
            </h3>
            <p class="mt-3 max-w-[44ch] text-lead text-bone/75" data-product-body>
              {act.body}
            </p>
          </div>
        ))}
      </div>
    </div>
    <ol class="grid grid-cols-3 gap-3 md:col-span-5 md:col-start-8 lg:col-span-4 lg:col-start-9" aria-label="Steps">
      {acts.map((act, i) => (
        <li class="flex flex-col gap-3" data-product-tab aria-current={i === 0 ? 'step' : undefined}>
          <span class="font-mono text-label uppercase text-dim transition-colors duration-500 [[aria-current]_&]:text-bone">
            {act.tab}
          </span>
          <span class="relative h-0.5 overflow-hidden bg-bone/15">
            <span class="absolute inset-0 origin-left bg-signal" style="transform: scaleX(0)" data-product-step />
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>
