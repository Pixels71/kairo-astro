---
import { Image } from 'astro:assets';
import { resolveImage } from '@/utils/image';

const captions = [
  {
    title: 'Every signal in one place.',
    body: 'Metrics, tickets, calls and docs stream in from the tools your team already uses.',
  },
  {
    title: 'The noise filtered out.',
    body: 'Kairo learns what normal looks like for each number, so only real changes surface.',
  },
  {
    title: 'The moment, flagged.',
    body: 'When something shifts, the owner gets a brief with the cause, the size and a next step.',
  },
];
---

<section id="product" class="relative h-[100dvh] overflow-hidden" data-product aria-labelledby="product-title">
  <div class="absolute inset-0" data-product-media>
    <Image
      src={resolveImage('/images/product-reveal.jpg')}
      alt="Commuters blurred into streaks of orange light in a bright corridor"
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover brightness-[0.62] saturate-[1.15]"
      data-product-image
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-ink/25" data-product-shade></div>
  </div>

  <h2
    id="product-title"
    class="shell pointer-events-none absolute inset-0 flex flex-col items-start justify-between py-[16vh] font-display text-display font-extrabold text-bone md:flex-row md:items-center md:py-0">
    <span class="block" data-product-word="left">Signal,</span>
    <span class="block self-end md:self-auto" data-product-word="right">not noise.</span>
  </h2>

  <div class="shell absolute inset-x-0 bottom-0 grid grid-cols-1 gap-8 pb-10 md:grid-cols-12 md:items-end md:pb-14">
    <div class="grid md:col-span-6 lg:col-span-5">
      {
        captions.map((caption, i) => (
          <div class="[grid-area:1/1]" data-product-caption style={i === 0 ? undefined : 'opacity:0'}>
            <h3 class="font-display text-subtitle font-bold text-bone">{caption.title}</h3>
            <p class="mt-3 max-w-[42ch] text-mute">{caption.body}</p>
          </div>
        ))
      }
    </div>
    <div class="flex items-center gap-2 md:col-span-4 md:col-start-9" aria-hidden="true">
      {
        captions.map(() => (
          <span class="relative h-0.5 flex-1 overflow-hidden bg-bone/20">
            <span class="absolute inset-0 origin-left bg-bone" style="transform: scaleX(0)" data-product-step />
          </span>
        ))
      }
    </div>
  </div>
</section>
