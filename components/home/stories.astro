---
import Button from '@/components/shared/ui/button.astro';
import Media from '@/components/shared/ui/media.astro';
import { getStories } from '@/utils/collections';

const stories = (await getStories()).slice(0, 4);
---

<section class="relative overflow-hidden py-24 lg:py-0" data-pan aria-labelledby="stories-title">
  <div
    class="no-scrollbar flex snap-x snap-mandatory items-stretch gap-4 overflow-x-auto px-4 md:gap-6 md:px-8 lg:h-[100dvh] lg:snap-none lg:items-center lg:gap-10 lg:overflow-visible lg:pr-0 lg:pl-[max(2rem,calc((100vw-1680px)/2+2rem))]"
    data-pan-track>
    <div class="flex w-[78vw] shrink-0 snap-start flex-col justify-between gap-10 md:w-[42vw] lg:h-[70dvh] lg:w-[28vw]">
      <h2 id="stories-title" class="font-display text-title font-bold text-bone" data-split>
        Teams that saw it coming.
      </h2>
      <div class="flex flex-col items-start gap-6" data-reveal>
        <p class="max-w-[34ch] text-mute">
          Freight networks, labs and payment companies use Kairo to hear about problems while they are still small.
        </p>
        <Button label="All customer stories" href="/customers" variant="outline" />
      </div>
    </div>
    {stories.map((story) => (
      <a
        href={`/customers/${story.id}`}
        class="group flex w-[78vw] shrink-0 snap-start flex-col gap-5 md:w-[46vw] lg:w-[34vw]"
        data-chip="View story"
        data-label={story.data.client}>
        <Media
          src={story.data.cover}
          alt={story.data.summary}
          class="media-zoom aspect-[4/5] w-full lg:aspect-auto lg:h-[58dvh]"
          sizes="(min-width: 1024px) 34vw, 80vw"
          imgData={{ 'data-pan-parallax': '' }}
        />
        <div class="flex items-start justify-between gap-6">
          <h3 class="max-w-[24ch] font-display text-[1.375rem] leading-[1.15] font-bold tracking-[-0.02em] text-bone md:text-2xl">
            {story.data.title}
          </h3>
          <span class="shrink-0 pt-1.5 font-mono text-label text-mute uppercase">{story.data.client}</span>
        </div>
      </a>
    ))}
    <div class="hidden w-[8vw] shrink-0 lg:block" aria-hidden="true"></div>
  </div>
  <div class="shell pointer-events-none absolute inset-x-0 bottom-10 hidden lg:block" aria-hidden="true">
    <div class="h-px bg-line">
      <div class="h-full origin-left bg-signal" style="transform: scaleX(0)" data-pan-progress></div>
    </div>
  </div>
</section>
