---
import { Image } from 'astro:assets';
import Icon from '@/components/shared/icons/icon.astro';
import Odometer from '@/components/shared/ui/odometer.astro';
import { stats, testimonials } from '@/data/proof';
import { resolveImage } from '@/utils/image';
---

<section class="shell py-28 md:py-40" data-proof aria-label="What customers say">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
    <div
      class="relative aspect-[4/5] overflow-hidden bg-ink-3 md:aspect-[5/4] lg:col-span-5 lg:aspect-[4/5]"
      data-reveal-media>
      {testimonials.map((item, i) => (
        <Image
          src={resolveImage(item.image)}
          alt={`Portrait of ${item.name}`}
          widths={[600, 900, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="absolute inset-0 size-full object-cover"
          style={i === 0 ? undefined : 'clip-path: inset(0 0 0 100%)'}
          data-proof-image
        />
      ))}
    </div>
    <div class="flex flex-col lg:col-span-7 lg:col-start-6">
      <div class="grid">
        {testimonials.map((item, i) => (
          <figure
            class="[grid-area:1/1]"
            data-proof-item
            aria-hidden={i === 0 ? undefined : 'true'}
            style={i === 0 ? undefined : 'visibility:hidden'}>
            <blockquote class="font-display text-[clamp(1.625rem,2.4vw,2.625rem)] leading-[1.1] font-medium tracking-[-0.025em] text-bone">
              <p data-proof-quote>&ldquo;{item.quote}&rdquo;</p>
            </blockquote>
            <figcaption class="mt-8 flex flex-col gap-1" data-proof-meta>
              <span class="font-medium text-bone">{item.name}</span>
              <span class="text-sm text-mute">
                {item.role}, {item.company}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="mt-12 flex items-center gap-3">
        <button
          type="button"
          class="group grid size-12 place-items-center rounded-full border border-line-strong text-bone transition-colors duration-300 hover:border-bone hover:bg-bone hover:text-ink"
          aria-label="Previous testimonial"
          data-proof-prev>
          <Icon name="arrow-left" />
        </button>
        <button
          type="button"
          class="group relative grid size-12 place-items-center rounded-full text-bone transition-colors duration-300 hover:bg-bone hover:text-ink"
          aria-label="Next testimonial"
          data-proof-next>
          <svg viewBox="0 0 48 48" class="absolute inset-0 size-full -rotate-90" aria-hidden="true">
            <circle cx="24" cy="24" r="23" fill="none" stroke="var(--color-line-strong)"></circle>
            <circle
              cx="24"
              cy="24"
              r="23"
              fill="none"
              stroke="var(--color-signal)"
              stroke-width="1.5"
              pathLength="1"
              stroke-dasharray="1"
              stroke-dashoffset="1"
              data-proof-ring></circle>
          </svg>
          <Icon name="arrow-right" />
        </button>
      </div>
    </div>
  </div>

  <dl class="mt-24 grid grid-cols-1 gap-10 border-t border-line pt-10 md:mt-32 md:grid-cols-3">
    {stats.map((stat) => (
      <div data-reveal>
        <dt class="sr-only">{stat.label}</dt>
        <dd class="font-display text-display font-extrabold text-bone">
          <Odometer value={`${stat.value.toFixed(stat.decimals ?? 0)}${stat.suffix ?? ''}`} />
        </dd>
        <dd class="mt-3 max-w-[22ch] text-mute">{stat.label}</dd>
      </div>
    ))}
  </dl>
</section>
