---
import { cn } from '@/utils/cn';
import { chars } from '@/utils/text';

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<span class={cn('roll', className)} aria-hidden="true">
  {chars(text).map((c, i) => <span class="roll-char" data-c={c} style={`--i:${i}`}>{c}</span>)}
</span>
<span class="sr-only">{text}</span>
