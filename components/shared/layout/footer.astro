---
import Icon from '@/components/shared/icons/icon.astro';
import PulseUnderline from '@/components/shared/ui/pulse-underline.astro';
import SignalLine from '@/components/shared/ui/signal-line.astro';
import TextRoll from '@/components/shared/ui/text-roll.astro';
import { footerCopy, footerGroups } from '@/data/footer';
import { site } from '@/data/site';
import { chars } from '@/utils/text';

const { newsletter } = footerCopy;
const word = chars(site.name.toUpperCase());
const wordSize = `clamp(3rem, ${Math.min(23, 118 / word.length).toFixed(2)}vw, 22rem)`;
---

<footer class="relative z-0 overflow-hidden bg-ink-2 lg:sticky lg:bottom-0" data-footer>
  <div class="shell pt-14 md:pt-16" data-footer-inner>
    <div class="grid grid-cols-1 gap-14 md:grid-cols-12">
      <div class="md:col-span-6 lg:col-span-5">
        <h2 class="max-w-[14ch] font-display text-subtitle font-bold text-bone">{newsletter.title}</h2>
        <form
          class="mt-8 max-w-md"
          data-newsletter
          data-msg-loading={newsletter.loading}
          data-msg-success={newsletter.success}
          data-msg-error={newsletter.error}
          novalidate>
          <label for="newsletter-email" class="font-mono text-label text-mute uppercase">
            {newsletter.label}
          </label>
          <div
            class="mt-3 flex items-center gap-2 rounded-full border border-line-strong bg-ink p-1.5 pl-5 transition-colors duration-300 focus-within:border-bone data-[state=error]:border-signal"
            data-newsletter-field>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder={newsletter.placeholder}
              class="min-w-0 flex-1 bg-transparent text-bone placeholder:text-dim focus:outline-none"
              aria-describedby="newsletter-status"
            />
            <button
              type="submit"
              class="group relative grid size-11 shrink-0 place-items-center overflow-hidden rounded-full bg-bone text-ink transition-[scale] duration-300 active:scale-95"
              aria-label="Subscribe"
              data-newsletter-submit>
              <span class="btn-icon" data-dir="right">
                <Icon name="arrow-right" />
                <Icon name="arrow-right" />
              </span>
            </button>
          </div>
          <p id="newsletter-status" class="mt-3 min-h-6 text-sm text-mute" role="status" data-newsletter-status>
            {newsletter.note}
          </p>
        </form>
      </div>
      <div class="grid grid-cols-2 gap-10 md:col-span-6 lg:col-span-5 lg:col-start-8 lg:grid-cols-3">
        {footerGroups.map((group) => (
          <div>
            <h3 class="font-mono text-label font-normal text-mute uppercase">{group.title}</h3>
            <ul class="mt-5 flex flex-col gap-3">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="group relative inline-flex text-bone">
                    <TextRoll text={link.label} />
                    <PulseUnderline />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div>
          <h3 class="font-mono text-label font-normal text-mute uppercase">{footerCopy.followTitle}</h3>
          <ul class="mt-5 flex flex-col gap-3">
            {site.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${site.name} on ${social.label}`}
                  class="group relative inline-flex items-center gap-2 text-bone">
                  <Icon name={social.icon === 'x' ? 'x-logo' : social.icon} class="text-mute" />
                  <TextRoll text={social.label} />
                  <PulseUnderline />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <SignalLine class="mt-8 h-20 md:mt-10 md:h-20" spike={0.18} />
    <div class="flex items-center justify-between gap-6 pt-4 text-sm text-mute">
      <p>{footerCopy.legal}</p>
      <button
        type="button"
        class="group flex items-center gap-3 text-bone"
        data-back-top
        aria-label={footerCopy.backToTop}>
        <span class="hidden sm:inline">
          <TextRoll text={footerCopy.backToTop} />
        </span>
        <span class="relative grid size-11 place-items-center">
          <svg viewBox="0 0 44 44" class="absolute inset-0 size-full -rotate-90" aria-hidden="true">
            <circle cx="22" cy="22" r="21" fill="none" stroke="var(--color-line-strong)" stroke-width="1"></circle>
            <circle
              cx="22"
              cy="22"
              r="21"
              fill="none"
              stroke="var(--color-signal)"
              stroke-width="1.5"
              pathLength="1"
              stroke-dasharray="1"
              stroke-dashoffset="1"
              data-back-top-ring></circle>
          </svg>
          <span class="btn-icon" data-dir="up">
            <Icon name="arrow-up" />
            <Icon name="arrow-up" />
          </span>
        </span>
      </button>
    </div>
  </div>

  <div class="relative pt-12" data-footer-mark aria-hidden="true">
    <p
      style={`font-size:${wordSize}`}
      class="flex justify-center px-3 font-display leading-[0.82] font-extrabold tracking-[-0.06em] whitespace-nowrap text-bone"
      data-footer-word>
      {word.map((c, i) => (
        <span class={i === word.length - 1 ? 'inline-block text-signal' : 'inline-block'} data-footer-letter>
          {c}
        </span>
      ))}
    </p>
  </div>
</footer>
