---
import type { SimpleIcon } from 'simple-icons';
import { cn } from '@/utils/cn';

interface Props {
  icon: SimpleIcon;
  class?: string;
  label?: boolean;
}

const { icon, class: className, label = true } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class={cn('size-6 fill-current', className)}
  role={label ? 'img' : undefined}
  aria-label={label ? icon.title : undefined}
  aria-hidden={label ? undefined : 'true'}>
  <path d={icon.path} />
</svg>
