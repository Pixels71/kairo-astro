---
import Media from '@/components/shared/ui/media.astro';
import { milestones } from '@/data/about';
import { aboutPage } from '@/data/pages';
---

<section class="relative overflow-hidden border-t border-line py-24 lg:py-0" data-pan aria-labelledby="timeline-title">
  <div
    class="no-scrollbar flex snap-x snap-mandatory items-stretch gap-4 overflow-x-auto px-4 md:gap-6 md:px-8 lg:h-[100dvh] lg:snap-none lg:items-center lg:gap-16 lg:overflow-visible lg:pr-0 lg:pl-[max(2rem,calc((100vw-1680px)/2+2rem))]"
    data-pan-track>
    <div class="flex w-[78vw] shrink-0 snap-start flex-col justify-center md:w-[40vw] lg:w-[26vw]">
      <h2 id="timeline-title" class="font-display text-title font-bold text-bone" data-split>
        {aboutPage.timeline.title}
      </h2>
      <p class="mt-6 max-w-[32ch] text-mute" data-reveal>
        {aboutPage.timeline.body}
      </p>
    </div>
    {milestones.map((milestone, i) => (
      <article
        class={`flex w-[78vw] shrink-0 snap-start flex-col gap-6 md:w-[44vw] lg:w-[30vw] ${i % 2 ? 'lg:mt-32' : 'lg:-mt-20'}`}>
        <p class="font-display text-[clamp(4rem,8vw,8.5rem)] leading-[0.8] font-extrabold tracking-[-0.06em] text-signal">
          {milestone.year}
        </p>
        <Media
          src={milestone.image}
          alt=""
          class="aspect-[4/3] w-full"
          sizes="(min-width: 1024px) 30vw, 80vw"
          imgData={{ 'data-pan-parallax': '' }}
        />
        <div>
          <h3 class="font-display text-subtitle font-bold text-bone">{milestone.title}</h3>
          <p class="mt-3 max-w-[38ch] text-mute">{milestone.body}</p>
        </div>
      </article>
    ))}
    <div class="hidden w-[10vw] shrink-0 lg:block" aria-hidden="true"></div>
  </div>
  <div class="shell pointer-events-none absolute inset-x-0 bottom-10 hidden lg:block" aria-hidden="true">
    <div class="h-px bg-line">
      <div class="h-full origin-left bg-signal" style="transform: scaleX(0)" data-pan-progress></div>
    </div>
  </div>
</section>
