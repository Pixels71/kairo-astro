---
import Media from '@/components/shared/ui/media.astro';
import NumberFlow from '@/components/shared/ui/number-flow.astro';
import { aboutPage } from '@/data/pages';

const { lines, facts, intro, image, imageAlt, accent } = aboutPage.hero;
---

<section class="shell pt-36 pb-20 md:pt-44 md:pb-28" aria-labelledby="about-title">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <h1
        id="about-title"
        class="font-display text-[clamp(3rem,8vw,10rem)] leading-[0.9] font-extrabold tracking-[-0.05em] text-bone">
        {lines.map((line, i) => (
          <span class="block overflow-hidden pb-[0.06em]" data-hero-line>
            <span class={i === accent ? 'block text-signal' : 'block'}>{line}</span>
          </span>
        ))}
      </h1>
      <p class="mt-10 max-w-[46ch] text-lead text-mute md:mt-14" data-intro>
        {intro}
      </p>
    </div>
    <Media
      src={image}
      alt={imageAlt}
      class="aspect-[4/5] lg:col-span-4 lg:mt-24"
      sizes="(min-width: 1024px) 33vw, 100vw"
      parallax={0.2}
      priority
    />
  </div>
  <dl class="mt-20 grid grid-cols-1 gap-8 border-t border-line pt-8 sm:grid-cols-3 md:mt-28">
    {facts.map((fact) => (
      <div data-reveal>
        <dt class="text-sm text-mute">{fact.label}</dt>
        <dd class="mt-2 font-display text-title font-bold text-bone">
          <NumberFlow value={fact.value} from={fact.from} suffix={fact.suffix} grouping={fact.grouping} duration={2} />
        </dd>
      </div>
    ))}
  </dl>
</section>
