---
import Media from '@/components/shared/ui/media.astro';
import type { Post } from '@/utils/collections';
import { formatDate } from '@/utils/text';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<section class="shell pb-20 md:pb-28" aria-label="Featured article">
  <a
    href={`/journal/${post.id}`}
    class="group grid grid-cols-1 gap-8 md:grid-cols-12 md:items-end md:gap-10"
    data-chip="Read"
    data-label="Journal">
    <Media
      src={post.data.cover}
      alt=""
      class="media-zoom aspect-[4/3] md:col-span-7 md:aspect-[16/11]"
      sizes="(min-width: 768px) 58vw, 100vw"
      priority
    />
    <div class="md:col-span-5" data-reveal>
      <p class="font-mono text-label text-mute uppercase">
        {post.data.category}
        <span class="mx-2 text-dim">/</span>
        {formatDate(post.data.date)}
      </p>
      <h2 class="mt-5 font-display text-title font-bold text-bone transition-colors duration-500 group-hover:text-signal">
        {post.data.title}
      </h2>
      <p class="mt-5 max-w-[44ch] text-mute">{post.data.excerpt}</p>
      <p class="mt-8 text-sm text-bone">{post.data.readTime}</p>
    </div>
  </a>
</section>
